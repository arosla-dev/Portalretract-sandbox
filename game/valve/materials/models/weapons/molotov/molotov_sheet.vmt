VertexLitGeneric
{
	$baseTexture "models\Weapons\molotov\molotov_sheet"
	$bumpmap "models\Weapons\molotov\molotov_sheet_normal"
	$normalmapalphaenvmapmask 1
	$translucent 1
	$envmap "env_cubemap"	
	

	$phong 1
	$phongexponent 120
	$phongfresnelranges "[1 0.5 8]"
	$phongboost 70

	$rimlight               1
	$rimlightexponent       5
	$rimlightboost          1	

	
}
