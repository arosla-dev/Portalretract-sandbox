"VertexLitGeneric"
{
	//GLOBA

	//BASE TEXTURE
	"$baseTexture"    "models/weapons/w_icegun/ice_surface"
	"$baseColorTint" "[.3 .3 .8]" //tints base color, uses alpha channel of base texture as a mask
	"$opacityTexture" "models/weapons/w_icegun/ice_surface_opacity" //transparency mask, independent of fresnel term 

	//NORMAL MAP
	"$normalMap"	"models/weapons/w_icegun/ice_surface_normal"
	"$bumpstrength" "10.5"

	//DIFFUSE
	"$diffuseScale" "2.3"

	//SPECULAR
	"$specMaskTexture"	"models/weapons/w_icegun/ice_surface_specmask"
	"$phongexponent"	"400"			// specular exponent of first phong highlight (on the interior layer)
	"$phongboost"		"6"				// specular boost of first phong highlight
	"$phongexponent2"	"88"			// specular exponent of second phong highlight (on the outer layer)
	"$phongboost2"		"14"				// specular boost of second phong highlight

	//RIM
	"$rimlightexponent" "3"
	"$rimlightboost" "4.5"

	//ENVIRONMENT MAP
	"$envMap"		"models/weapons/w_icegun/ice_surface_envmap"
	"$envMapTint"	"[0.1 0.14 0.2]"

	//FRESNEL
	"$fresnelBumpStrength" "0"
	//"$fresnelWarpTexture" "Models/blob/blob_fresnel_warp"
	"$translucentFresnelMinMaxExp" "[0 0.5 1]"

}
