$animation "a_idle1" "v_flaregun_anims\idle1.smd" {
	fps 30
	loop
}

$animation "a_draw" "v_flaregun_anims\draw.smd" {
	fps 30
}

$animation "a_fire" "v_flaregun_anims\fire.smd" {
	fps 30
}

$animation "a_reload" "v_flaregun_anims\reload.smd" {
	fps 30
}

$animation "a_dryfire" "v_flaregun_anims\dryfire.smd" {
	fps 30
}

$sequence "idle1" {
	"a_idle1"
	activity "ACT_VM_IDLE" 1
	fadein 0.2
	fadeout 0.2
	node 1
}

$sequence "draw" {
	"a_draw"
	activity "ACT_VM_DRAW" 1
	fadein 0.2
	fadeout 0.2
	node 1
	snap
}

$sequence "fire" {
	"a_fire"
	activity "ACT_VM_PRIMARYATTACK" 1
	fadein 0.2
	fadeout 0.2
	node 2
	snap
}

$sequence "reload" {
	"a_reload"
	activity "ACT_VM_RELOAD" 1
	{ event 5004 1 "Weapon_Flaregun.Reload" }
	fadein 0.2
	fadeout 0.2
	node 1
}

$sequence "dryfire" {
	"a_dryfire"
	activity "ACT_VM_DRYFIRE" 1
	fadein 0.2
	fadeout 0.2
	node 2
	snap
}

